whipper/

# cyanrip output dirs (*[FORMAT]/) when the ripper runs in the repo by mistake.
# the wrapper cd's into ~/media/audio/music/rip, so these only appear on
# accidental direct runs. Brackets escaped — [FLAC] is a gitignore char-class otherwise.
*\[FLAC]/
*\[MP3]/
*\[OPUS]/
*\[OGG]/
*\[WavPack]/
*.cue
*.m3u

# beets state
.beetsstate

# rip-video accidental direct-run output (the wrapper cd's into ~/media,
# so these only appear if HandBrakeCLI runs in the repo).
*.mkv
*.mp4

# scratch logs from manual makemkvcon / rip debugging
*.log

# Task files
tasks

# HandBrakeCLI --help dump (reference for the transcode flags)
HandBreakCLI-help.txt

# Scratchpad
.scratch/

# local agent config
.env
