#!/usr/bin/env bash
# ./skive — the only door into the skive box (podman compose; docker works too).
# With args it runs the container's skive; with no args it opens a shell inside.
set -euo pipefail
cd "$(dirname "$0")"

if command -v podman >/dev/null 2>&1; then
	engine=(podman compose)
else
	engine=(docker compose)
fi

# Optical nodes exist only on machines with drives; a device compose lists must
# exist at container create, so drive-less boxes run without the rip override
# (they would die on `stat /dev/sr0`). The drive count differs between boxes
# (the rip box has one drive), so the override is generated from the nodes the
# host actually has rather than a checked-in list that names them all.
files=(-f compose.yaml)
if compgen -G '/dev/sr*' >/dev/null; then
	rip_yaml=$(mktemp /tmp/skive-rip-devices.XXXXXX.yaml)
	trap 'rm -f "$rip_yaml"' EXIT
	{
		echo "services:"
		echo "  skive:"
		echo "    devices:"
		for node in /dev/sr* /dev/sg*; do
			if [ -e "$node" ]; then
				echo "      - $node:$node"
			fi
		done
	} >"$rip_yaml"
	files+=(-f "$rip_yaml")
fi

if [ "$#" -gt 0 ]; then
	"${engine[@]}" "${files[@]}" run --rm skive skive "$@"
else
	"${engine[@]}" "${files[@]}" run --rm skive bash
fi
