<?xml version="1.0" encoding="utf-8"?>
<!--
  MakeMKV selection profile — picks audio + subtitle tracks at rip time so the
  transcode step is a dumb pass-through re-encode (video only).

  Based on MakeMKV's bundled default.mmcp.xml; only the track-selection string is
  changed from the GUI preference value ($app_DefaultSelectionString) to a
  hardcoded one, so a rip is independent of whoever is logged in.

  Selection string operators (MakeMKV docs):
    +sel:<lang|keyword>   select tracks matching a language or keyword
    -sel:<keyword>        deselect
      nolang              tracks with no language tag
      single              the only track of its type (safety net)
      havemulti | havecore  redundant multi-channel / core duplicates
      mvcvideo            MVC (3D) video

  BASELINE selection string: keep English + Danish audio and subtitles (plus
  no-lang and single tracks), drop MVC and duplicate multi/core tracks.

  skive (rip movie/tv) does NOT hand-edit this file — it reads it, replaces the
  BASELINE literal below with a per-movie language list (original-language audio +
  Danish/English subtitles), and feeds that temp copy to makemkvcon as its
  profile.
  MakeMKV's selection string is type-agnostic: one list covers every track type
  (audio(lang)/subtitle(lang) qualifiers are invalid tokens), so the list is the
  union of what audio and subtitles each need. This BASELINE is BOTH the manual-use
  default AND the substitution target (skive.makemkv.BASELINE must stay
  byte-identical to it). Edit the one string in each defaultSelection attribute
  below (and the app_DefaultSelectionString line).
-->
<profile>
    <!-- profile name -->
    <name lang="eng">cd-ripping default</name>

    <!-- Common MKV flags -->
    <mkvSettings
        ignoreForcedSubtitlesFlag="true"
        useISO639Type2T="false"
        setFirstAudioTrackAsDefault="true"
        setFirstSubtitleTrackAsDefault="true"
        setFirstForcedSubtitleTrackAsDefault="true"
        insertFirstChapter00IfMissing="true"
    />

    <!-- Ignored by MakeMKV 1.12.4+; selection is driven by defaultSelection below. -->
    <profileSettings
        app_DefaultSelectionString="-sel:all,+sel:(eng|dan|nolang|single),-sel:(havemulti|havecore),-sel:mvcvideo"
    />

    <!-- Output formats currently supported by MakeMKV -->
    <outputSettings name="copy" outputFormat="directCopy">
        <description lang="eng">Copy track as is</description>
        <description lang="ger">Track 1:1 kopieren</description>
    </outputSettings>

    <outputSettings name="lpcm" outputFormat="LPCM-raw">
        <description lang="eng">Save as raw LPCM</description>
        <description lang="ger">Als RAW LPCM speichern</description>
    </outputSettings>

    <outputSettings name="wavex" outputFormat="LPCM-wavex">
        <description lang="eng">Save as LPCM in WAV container</description>
        <description lang="ger">Als LPCM im WAV-Container speichern</description>
    </outputSettings>

    <outputSettings name="flac-best" outputFormat="FLAC">
        <description lang="eng">Save as FLAC (best compression)</description>
        <description lang="ger">Als FLAC speichern (höchste Komprimierungsstufe)</description>
        <extraArgs>-compression_level 12</extraArgs>
    </outputSettings>

    <outputSettings name="flac-fast" outputFormat="FLAC">
        <description lang="eng">Save as FLAC (fast compression)</description>
        <extraArgs>-compression_level 5</extraArgs>
    </outputSettings>

    <!-- Default rule - copy as is -->
    <trackSettings input="default">
        <output outputSettingsName="copy"
                defaultSelection="-sel:all,+sel:(eng|dan|nolang|single),-sel:(havemulti|havecore),-sel:mvcvideo">
        </output>
    </trackSettings>

    <!-- Save LPCM mono or stereo as raw LPCM -->
    <trackSettings input="LPCM-stereo">
        <output outputSettingsName="lpcm"
                defaultSelection="-sel:all,+sel:(eng|dan|nolang|single),-sel:(havemulti|havecore),-sel:mvcvideo">
        </output>
    </trackSettings>

    <!-- Put multi-channel LPCM into WAVEX container-->
    <trackSettings input="LPCM-multi">
        <output outputSettingsName="wavex"
                defaultSelection="-sel:all,+sel:(eng|dan|nolang|single),-sel:(havemulti|havecore),-sel:mvcvideo">
        </output>
    </trackSettings>

</profile>
