# TMDB API key (bitwarden reference; skive/tmdb.py)
TMDB_API_KEY=bw://Homelab/TMDB-full/password
# MakeMKV registration key (BD rips; written to ~/.MakeMKV/settings.conf)
MAKEMKV_KEY=
# Videos share mountpoint inside the box (default /mnt/videos)
VIDEOS_MOUNT=/mnt/videos
# Music share mountpoint inside the box (default /mnt/music)
MUSIC_MOUNT=/mnt/music
# Minimum title length for disc scans, makemkvcon minlength (default 120)
RIP_MINLENGTH=120
